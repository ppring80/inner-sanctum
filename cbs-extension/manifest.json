{
  "manifest_version": 3,
  "name": "The Inner Sanctum — Connect",
  "version": "0.5.2",
  "description": "Read-only fantasy league connection helper for The Inner Sanctum.",

  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "https://*.football.cbssports.com/*",
    "https://fantasy.espn.com/*",
    "https://lm-api-reads.fantasy.espn.com/*",
    "https://theinnersanctum.xyz/*",
    "https://www.theinnersanctum.xyz/*"
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": {
    "service_worker": "service-worker-v050.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.football.cbssports.com/*"
      ],
      "js": [
        "cbs-browser-connector.js",
        "cbs-free-agent-capture.js",
        "cbs-main-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.football.cbssports.com/*"
      ],
      "js": [
        "cbs-content-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://fantasy.espn.com/football/*"
      ],
      "js": [
        "espn-main-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://fantasy.espn.com/football/*"
      ],
      "js": [
        "espn-content-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://theinnersanctum.xyz/connect-league*",
        "https://www.theinnersanctum.xyz/connect-league*"
      ],
      "js": [
        "sanctum-content-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],

  "action": {
    "default_title": "The Inner Sanctum — Connect",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
